# Pookie — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local (gitignored).
# Staging/production values live in Cloudflare Pages project settings,
# NOT in this repo. See docs/ENV-MANAGEMENT.md.

# --- Supabase (project: pookie / fspvcuaupkdsekpwmnep) ---
# Public. Safe to expose in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://fspvcuaupkdsekpwmnep.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SERVER ONLY) ---
# NEVER prefix with NEXT_PUBLIC_. Never commit a real value.
# Used by: Edge Functions, worker scripts, ETL. Lives in Pages env (server)
# and the Secure Vault for local ops — never in the repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI tutor worker (Cloudflare) ---
# Pookie tutor backend (llama-3.3-70b): https://pookie-tutor.mehedikamal.workers.dev
# Client-read at build time (NEXT_PUBLIC_) — matches the proven d-dash
# integration (direct /chat + /muse-queue calls from the chat UI).
# NOTE: this differs from the earlier server-proxy plan (POOKIE_TUTOR_URL +
# /api/v1/tutor/chat) — founder directed the d-dash approach for staging.
# Staging: baked from the GitHub secret `POOKIE_TUTOR_URL` in CI builds
# (workflow maps it to NEXT_PUBLIC_POOKIE_TUTOR_URL), or from this
# `.env.local` when building locally via deploy-staging.py. The Pages
# dashboard env does NOT affect this variable: with the wrangler
# direct-deploy flow there is no Pages-side build, so dashboard
# NEXT_PUBLIC_* values are never baked into the bundle (see
# docs/ENV-MANAGEMENT.md principle 4). NEVER set on the production `pookie`
# project.
NEXT_PUBLIC_POOKIE_TUTOR_URL=https://pookie-tutor.mehedikamal.workers.dev

# --- AI tutor worker, server-side (reserved) ---
# Cloudflare Worker serving the Pookie tutor (tenant-aware prompts).
# Server-only by design: the app proxies chat via /api/v1/tutor/chat so the
# worker URL never enters the client bundle. NEVER prefix with NEXT_PUBLIC_.
POOKIE_TUTOR_URL=

# --- Asset versioning (cache-busting) ---
# Set at build time (CI uses the git SHA). The frontend appends ?v=<this>
# to asset URLs. The deploy pipeline verifies exactly one version is live.
# See AGENTS.md "Deploy versioning" and scripts/verify-asset-version.sh.
NEXT_PUBLIC_ASSET_VERSION=dev

# --- App URL (canonical, per environment) ---
# Staging:      https://pookie-staging.pages.dev
# Production:   https://pookie.pages.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
